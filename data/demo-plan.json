          {
            "name": "High skips (bounds from January)",
            "reps": 10,
            "cue": "Springy, quiet landings"
          },
          {
            "name": "Bulgarian split squat",
            "reps": 8,
            "per_side": true,
            "cue": "Back foot on sofa, lower slowly until back knee nearly touches the floor"
          },
          {
            "name": "Single-leg Romanian deadlift",
            "reps": 8,
            "per_side": true,
            "cue": "Hinge on one leg, flat back, reach towards the floor"
          },
          {
            "name": "Single-leg glute bridge",
            "reps": 10,
            "per_side": true,
            "cue": "Squeeze the glute at the top"
          },
          {
            "name": "Nordic lowers",
            "reps": "3-5",
            "cue": "Feet under the sofa, lower as slowly as you can, catch with your hands"
          }
        ]
      },
      "race_week": {
        "duration_min": 8,
        "exercises": [
          {
            "name": "Pogo hops",
            "reps": 20,
            "cue": "Light and springy"
          },
          {
            "name": "Single-leg calf raise on a step",
            "reps": 12,
            "per_side": true,
            "cue": "Controlled"
          }
        ]
      }
    },
    "progression": [
      "Weeks 0-3: 2 sets while learning the moves",
      "Week 4 onwards: 3 sets",
      "When top reps feel easy: lower over 3 s, then add a backpack (5 kg building to 10-15 kg)"
