# Strava API app (https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Long random string used to sign the session cookie.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Comma-separated Strava athlete IDs allowed to sign in (empty = anyone).
ALLOWED_ATHLETE_IDS=

# Used to decide what "today" is.
APP_TIMEZONE=Europe/London

# Strava API base URL. Strava moves to https://api-v3.strava.com on 4 Jan 2027.
STRAVA_API_BASE=https://www.strava.com/api/v3

# Neon Postgres. Added automatically by the Vercel Neon integration.
DATABASE_URL=

# Local demo only (never active on Vercel): in-memory store, fake runs.
# DEMO_MODE=1
# DEMO_TODAY=2026-12-02
